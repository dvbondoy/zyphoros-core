# Live-session-only packages. The installer removes these when installing.
live-boot
live-config
live-config-systemd

# live-config only *recommends* these, and the image is built with
# --apt-recommends false, so they must be listed explicitly:
#   user-setup  creates the live user (username= / password "live"). Without it
#               live-config skips account creation and autologin fails with
#               "Authentication failure".
#   live-tools  live system helpers, e.g. ejecting the medium on shutdown.
user-setup
live-tools
